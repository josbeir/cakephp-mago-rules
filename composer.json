{
  "name": "josbeir/cakephp-mago-rules",
  "description": "CakePHP coding-standard compatibility rules for Mago.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "carthage-software/mago": "^1.47"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "MagoCakePHP\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MagoCakePHP\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "cs-check": "mago format --check && mago lint",
    "cs-fix": "mago format && mago lint --fix",
    "validate-extension": "mago --workspace tests/corpus extension validate",
    "lint-corpus": "mago --workspace tests/corpus lint --only block-statement,mago-cakephp/trait-suffix,mago-cakephp/public-method-underscore,mago-cakephp/elseif,mago-cakephp/function-docblock,mago-cakephp/docblock-alignment,mago-cakephp/inherit-doc,mago-cakephp/return-type-docblock"
  },
  "config": {
    "sort-packages": true
  }
}
